{
  "title": "Artefact telemetry (operational)",
  "uid": "stdtel-operational",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Skill invocations / h",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (std_skill_name, std_harness) (rate(traces_span_metrics_calls_total{span_name=\"std.artefact.activation\",std_artefact_kind=\"skill\"}[1h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate by skill",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (std_skill_name) (rate(traces_span_metrics_calls_total{span_name=\"std.artefact.activation\",std_artefact_kind=\"skill\",status_code=\"STATUS_CODE_ERROR\"}[1h])) / sum by (std_skill_name) (rate(traces_span_metrics_calls_total{span_name=\"std.artefact.activation\",std_artefact_kind=\"skill\"}[1h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p50 skill window duration",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, std_skill_name) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"std.artefact.activation\",std_artefact_kind=\"skill\"}[1h])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Claude Code tokens by type",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(claude_code_token_usage_tokens_total[1h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Activations / h by artefact kind",
      "description": "Where the agent's work actually goes. Sub-agents and compaction were invisible before ADR-009; a session can have no skill activations at all and still be the most expensive one of the day.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (std_artefact_kind) (rate(traces_span_metrics_calls_total{span_name=\"std.artefact.activation\"}[1h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Sub-agent calls / h by type",
      "description": "Rate only \u2014 a sub-agent's token cost is a span attribute, so read that from the warehouse (warehouse/efficiency/), not from here.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (std_subagent_type) (rate(traces_span_metrics_calls_total{span_name=\"std.artefact.activation\",std_artefact_kind=\"subagent\"}[1h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p50 hook-observed turn duration",
      "description": "The harness's own turn timing, not our clock.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"std.artefact.activation\",std_artefact_kind=\"turn\"}[1h])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Compactions / h by reason",
      "description": "A rising auto-compaction rate is context pressure: the session is spending tokens re-reading itself. Pair with tokens_before in the warehouse.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (std_artefact_name) (rate(traces_span_metrics_calls_total{span_name=\"std.artefact.activation\",std_artefact_kind=\"compaction\"}[1h]))"
        }
      ]
    },
    {
      "id": 1,
      "title": "External spend calls / h by system",
      "type": "timeseries",
      "datasource": null,
      "description": "ADR-010 decision 7. Spend that happens outside the harness, reported by whatever spent it \u2014 a CLI the agent shells out to, or an MCP server calling models of its own. stdtel cannot observe this; it receives it, so an empty graph means either nothing ran or nothing is emitting, and those are different. The money is not here: cost is a Postgres figure, on the outcomes board.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": null,
          "expr": "sum by (std_artefact_name) (rate(traces_span_metrics_calls_total{span_name=\"std.artefact.activation\", std_artefact_kind=\"external\"}[5m])) * 3600",
          "legendFormat": "{{std_artefact_name}}"
        }
      ]
    }
  ],
  "description": "Invocation rate, errors, duration and token flow. The scorecard \u2014 first-time policy pass rate and the keep/refine/deprecate call \u2014 is on 'Skill scorecard'."
}
