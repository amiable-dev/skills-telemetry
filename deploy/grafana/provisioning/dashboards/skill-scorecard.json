{
  "title": "Skill telemetry (operational)",
  "uid": "stdtel-operational",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "Skill invocations / h",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (std_skill_name, std_harness) (rate(traces_span_metrics_calls_total{span_name=\"std.skill.invocation\"}[1h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate by skill",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (std_skill_name) (rate(traces_span_metrics_calls_total{span_name=\"std.skill.invocation\",status_code=\"STATUS_CODE_ERROR\"}[1h])) / sum by (std_skill_name) (rate(traces_span_metrics_calls_total{span_name=\"std.skill.invocation\"}[1h]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p50 skill window duration",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, std_skill_name) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"std.skill.invocation\"}[1h])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Claude Code tokens by type",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(claude_code_token_usage_tokens_total[1h]))"
        }
      ]
    }
  ],
  "description": "Invocation rate, errors, duration and token flow. The scorecard \u2014 first-time policy pass rate and the keep/refine/deprecate call \u2014 is on 'Skill scorecard'."
}
