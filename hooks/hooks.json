{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "stdtel-hook session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "stdtel-hook pre-tool-use"
          }
        ],
        "matcher": "Skill"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "stdtel-hook post-tool-use"
          }
        ],
        "matcher": "Skill"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "stdtel-hook post-tool-use-failure"
          }
        ],
        "matcher": "Skill"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "stdtel-hook stop"
          }
        ]
      }
    ]
  }
}
