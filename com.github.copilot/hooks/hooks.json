{
  "version": 1,
  "disableAllHooks": false,
  "hooks": {
    "sessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/stdtel-hook",
            "args": [
              "session-start"
            ],
            "env": {
              "STDTEL_HARNESS": "copilot-vscode"
            }
          }
        ]
      }
    ],
    "preToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/stdtel-hook",
            "args": [
              "pre-tool-use"
            ],
            "env": {
              "STDTEL_HARNESS": "copilot-vscode"
            }
          }
        ],
        "matcher": "Skill"
      }
    ],
    "postToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/stdtel-hook",
            "args": [
              "post-tool-use"
            ],
            "env": {
              "STDTEL_HARNESS": "copilot-vscode"
            }
          }
        ]
      }
    ],
    "postToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/stdtel-hook",
            "args": [
              "post-tool-use-failure"
            ],
            "env": {
              "STDTEL_HARNESS": "copilot-vscode"
            }
          }
        ]
      }
    ],
    "agentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/stdtel-hook",
            "args": [
              "stop"
            ],
            "env": {
              "STDTEL_HARNESS": "copilot-vscode"
            }
          }
        ]
      }
    ]
  }
}
