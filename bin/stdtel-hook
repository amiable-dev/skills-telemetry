#!/bin/sh
# Plugin hook launcher.
#
# The plugin's hooks.json cannot know where stdtel-hook is installed, and hook
# processes get a non-login `sh -c` whose PATH does not include a version
# manager's shims or a project venv. Shipping the bare name therefore failed with
# "stdtel-hook: command not found" on every tool call (issue #13).
#
# This resolves the real CLI and execs it. When it finds nothing it exits 0 in
# silence: a plugin installed without the package should record nothing, not
# error on every keystroke. Telemetry is never worth interrupting someone's work.
set -u

find_bin() {
    # explicit override wins, for unusual installs and for tests
    if [ -n "${STDTEL_HOOK_BIN:-}" ] && [ -x "${STDTEL_HOOK_BIN}" ]; then
        printf '%s' "${STDTEL_HOOK_BIN}"
        return 0
    fi
    # the locations `uv tool install` and `pipx install` actually use
    for candidate in \
        "${HOME:-}/.local/bin/stdtel-hook" \
        "${HOME:-}/.local/share/uv/tools/stdtel/bin/stdtel-hook" \
        "${HOME:-}/.local/pipx/venvs/stdtel/bin/stdtel-hook" \
        "/opt/homebrew/bin/stdtel-hook" \
        "/usr/local/bin/stdtel-hook"
    do
        if [ -x "${candidate}" ]; then
            printf '%s' "${candidate}"
            return 0
        fi
    done
    # finally PATH, which is usually empty of it but costs nothing to try
    resolved=$(command -v stdtel-hook 2>/dev/null) || return 1
    [ -n "${resolved}" ] || return 1
    printf '%s' "${resolved}"
}

if ! bin=$(find_bin); then
    # The plugin ships hooks and this launcher; the Python package ships
    # everything that runs. With the package absent nothing of ours executes —
    # `stdtel-doctor` does not exist either — so this launcher is the only part
    # of the install that can say so, and SessionStart output is the only place
    # a developer will see it.
    #
    # SessionStart only. The same line on every tool call is not information, it
    # is noise on every keystroke, which is how people learn to ignore it.
    if [ "${1:-}" = "session-start" ]; then
        printf 'stdtel: the plugin is installed but the `stdtel` package is not, so no telemetry is being recorded.\nInstall it with: uv tool install stdtel   (then restart Claude Code)\n'
    fi
    exit 0
fi
exec "${bin}" "$@"
